# FastAPI runtime
ENVIRONMENT=production
PORT=8000

# Managed PostgreSQL (Railway/Render)
DATABASE_URL=******HOST:5432/easebill

# Security
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list
CORS_ORIGINS=https://ease-bill.vercel.app

# Upload/output directories (only for local Docker setup)
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
